import os
from pyadf import *
if 'pyadfenv' not in globals():
    from pyadf.Initialization import *

h2o = molecule(os.path.join(pyadfenv.outdir, 'H2O.xyz'))
h2o.set_symmetry('.NOSYM')

# HF single point calculation

settings = diracsettings(method='CCSD(T)', hamiltonian='DC', nucmod='finite')
results = diracsinglepointjob(h2o, 'STO-3G', settings=settings).run()

scfenergy = results.get_scf_energy()

testobj.assertAlmostEqual(scfenergy, -75.00527436331232, 6)
testobj.assertAlmostEqual(results.get_energy('SCF'), -75.00527436331232, 6)

testobj.assertAlmostEqual(results.get_energy('MP2'), -75.04354563480258, 6)
testobj.assertAlmostEqual(results.get_energy('CCSD'), -75.05925489515927, 6)
testobj.assertAlmostEqual(results.get_energy('CCSD-T'), -75.05932844030693, 6)
testobj.assertAlmostEqual(results.get_energy('CCSD+T'), -75.05934977774157, 6)
testobj.assertAlmostEqual(results.get_energy('CCSD(T)'), -75.05933692949957 , 6)
testobj.assertAlmostEqual(results.get_total_energy(), -75.05933692949957, 6)
